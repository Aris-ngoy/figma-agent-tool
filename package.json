{
	"name": "figma-agent-tool-monorepo",
	"version": "0.0.0",
	"type": "module",
	"license": "MIT",
	"packageManager": "bun@1.2.23",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Aris-ngoy/figma-agent-tool.git"
	},
	"scripts": {
		"build": "turbo run build",
		"lint": "turbo run lint",
