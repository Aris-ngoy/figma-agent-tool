{
	"name": "figma-agent-tool",
	"version": "0.0.0",
	"description": "Design UI as files in your repo with any coding agent, preview it, and sync it with Figma both ways.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Aris-ngoy/figma-agent-tool.git",
		"directory": "packages/mcp-server"
	},
	"bin": {
		"figma-agent-tool": "./dist/bin.js"
	},
	"files": [
		"dist",
		"skill"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "bun build src/bin.ts --target node --outdir dist --external @google/design.md --external bufferutil --external utf-8-validate",
		"start": "bun src/bin.ts mcp",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@google/design.md": "0.4.0"
	},
	"devDependencies": {
		"@figma-agent-tool/design-project": "workspace:*",
		"@figma-agent-tool/handoff": "workspace:*",
		"@figma-agent-tool/preview": "workspace:*",
		"@figma-agent-tool/protocol": "workspace:*",
		"@figma-agent-tool/visual-diff": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@types/pngjs": "^6.0.5",
		"@types/ws": "^8.18.2",
		"pngjs": "^7.0.0",
		"ws": "^8.22.0",
		"zod": "4.6.7"
	}
}
